---
import { SERVICES } from '../data/services';
---

<section class="services" id="servicos" data-services>
  <div class="pattern pattern--dots-dark pattern--fade-left" aria-hidden="true"></div>
  <div class="container services__grid">
    <header class="services__intro">
      <h2 class="services__title" data-split-title>O que a Taiga faz pelo seu perfil</h2>
      <p class="services__lead">
        Três trabalhos que funcionam juntos ou separados, conforme o momento da sua marca.
      </p>
    </header>

    <ul class="services__list">
      {
        SERVICES.map((s) => (
          <li class="service" data-service>
            <div class="service__icon" data-service-icon data-icon={s.icon} aria-hidden="true">
              <canvas data-service-canvas />
              <svg class="service__fallback" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                {s.icon === 'search' && (
                  <>
                    <circle cx="27" cy="27" r="15" />
                    <path d="m38 38 15 15" />
                  </>
                )}
                {s.icon === 'chart' && (
                  <>
                    <rect x="10" y="38" width="10" height="16" rx="3" />
                    <rect x="27" y="26" width="10" height="28" rx="3" />
                    <rect x="44" y="12" width="10" height="42" rx="3" />
                  </>
                )}
                {s.icon === 'play' && (
                  <>
                    <rect x="8" y="14" width="48" height="36" rx="9" />
                    <path d="M27 24v16l14-8Z" />
                  </>
                )}
              </svg>
            </div>

            <h3 class="service__name">{s.name}</h3>
            <p class="service__summary">{s.summary}</p>
            <ul class="service__items">
              {
                s.items.map((item) => (
                  <li data-service-item>
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path d="m4.5 10.5 3.5 3.5 7.5-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
            {s.note && <p class="service__note">{s.note}</p>}
            {
              s.badge && (
                <p class="service__badge">
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M10 18s6-5.2 6-10a6 6 0 1 0-12 0c0 4.800 6 10 6 10Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                    <circle cx="10" cy="8" r="2.200" fill="currentColor" />
                  </svg>
                  {s.badge}
                </p>
              )
            }
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services {
    position: relative;
    overflow: clip;
    background: linear-gradient(180deg, #e9f1ec 0%, var(--paper) 22%, var(--paper) 100%);
    padding-block: clamp(4.5rem, 11vw, 9rem);
    scroll-margin-top: 2rem;
  }
  .services__grid {
    position: relative;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .services__title {
    font-size: var(--text-h2);
    color: var(--taiga-deep);
    max-width: 12ch;
  }
  .services__lead {
    margin-top: 1.25rem;
    max-width: 26rem;
    color: var(--ink-soft);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  /* ----------------------- Cards na horizontal ----------------------- */
  .services__list {
    display: grid;
    gap: 6rem;
    margin-top: 4.5rem;
  }
  .service {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 6.5rem clamp(1.5rem, 2.4vw, 2rem) clamp(1.75rem, 3vw, 2.25rem);
    border-radius: 1.75rem;
    background: linear-gradient(165deg, #ffffff 0%, #eef4ef 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.8),
      0 0 0 1px rgb(15 42 34 / 0.07),
      0 30px 60px -36px rgb(0 58 44 / 0.5);
    transition:
      transform 0.6s var(--ease-out),
      box-shadow 0.6s var(--ease-out);
  }
  .service:hover {
    transform: translateY(-6px);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.8),
      0 0 0 1px rgb(0 84 63 / 0.25),
      0 40px 70px -34px rgb(0 58 44 / 0.6);
  }

  /* ícone 3D flutuando sobre o topo do card */
  .service__icon {
    position: absolute;
    left: clamp(0.5rem, 1.5vw, 1.25rem);
    top: -4.75rem;
    width: 11.5rem;
    height: 11.5rem;
    pointer-events: none;
    color: var(--taiga);
  }
  .service__icon canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s;
  }
  .service__icon.is-3d canvas {
    opacity: 1;
  }
  .service__fallback {
    position: absolute;
    inset: 22%;
    width: 56%;
    height: 56%;
    transition: opacity 0.4s;
  }
  .service__icon.is-3d .service__fallback {
    opacity: 0;
  }

  .service__name {
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.2rem);
    color: var(--taiga-deep);
  }
  .service__summary {
    line-height: 1.55;
    color: var(--ink);
  }
  .service__items {
    display: grid;
    gap: 0.65rem;
    margin-block: 0.25rem;
  }
  .service__items li {
    display: grid;
    grid-template-columns: 1.35rem 1fr;
    gap: 0.75rem;
    align-items: start;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .service__items svg {
    width: 1.35rem;
    height: 1.35rem;
    margin-top: 0.05rem;
    padding: 0.2rem;
    border-radius: 50%;
    color: var(--on-dark);
    background: var(--grad-taiga);
  }
  .service__note {
    margin-top: auto;
    padding: 1rem 1.15rem;
    border-radius: 1rem;
    background: var(--paper-2);
    box-shadow: inset 3px 0 0 var(--taiga);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--ink);
  }
  .service__badge {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    background: var(--mist);
    color: var(--taiga-deep);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.3;
  }
  .service__badge svg {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
  }

  /* Celular: um card por vez, o que está no centro da tela fica em foco */
  @media (max-width: 999px) {
    :global(html.js:not(.reduced)) .service {
      opacity: 0.55;
    }
    :global(html.js:not(.reduced)) .service.is-active {
      opacity: 1;
    }
  }

  @media (min-width: 900px) {
    .services__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
      align-items: end;
      column-gap: 3rem;
    }
    .services__list {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1000px) {
    .services__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.25rem, 2.4vw, 2rem);
      margin-top: 5rem;
      align-items: stretch;
    }
  }
</style>
